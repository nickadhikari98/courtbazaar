[Unit]
Description=CourtBazaar backend (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=courtbazaar
WorkingDirectory=/var/www/courtbazaar/backend
EnvironmentFile=/var/www/courtbazaar/backend/.env
ExecStart=/var/www/courtbazaar/backend/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
