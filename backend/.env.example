# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=courtbazaar

# --- Auth ---
# Required, no default. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins. Do not use * in production.
CORS_ORIGINS=https://courtbazaar.com

# Comma-separated list of reverse-proxy IPs allowed to set X-Forwarded-For /
# X-Forwarded-Proto (read by uvicorn's --proxy-headers, enabled in
# deploy/courtbazaar.service). Leave unset in production behind the shipped
# nginx.conf — uvicorn then defaults to trusting only 127.0.0.1, which is
# exactly where nginx.conf's `proxy_pass http://127.0.0.1:8000/api/` connects
# from. Only change this if the reverse proxy ever runs on a different host.
# Never set this to "*" — that would trust a self-reported X-Forwarded-For
# from any client on the internet, defeating IP-based rate limiting/audit
# logging entirely.
FORWARDED_ALLOW_IPS=127.0.0.1

# Set to "true" only once real Google OAuth credentials are wired up.
# Currently disabled — see FOUNDING_ENGINEER_PLAYBOOK.md / audit report.
GOOGLE_OAUTH_ENABLED=false

APP_NAME=courtbazaar

# --- File uploads ---
MAX_UPLOAD_SIZE_BYTES=10485760

# --- File storage: Cloudflare R2 (S3-compatible) ---
# Create a free R2 bucket at dash.cloudflare.com -> R2, then an API token
# scoped to that bucket. Leave S3_ENDPOINT_URL blank to use real AWS S3
# instead (same code, different provider) — just also set S3_REGION to a
# real AWS region in that case (R2 uses "auto").
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=courtbazaar-uploads
S3_REGION=auto
S3_ACCESS_KEY_ID= 
S3_SECRET_ACCESS_KEY=

# --- Email: Brevo (recommended, free tier) or Resend ---
# BREVO_API_KEY must be a REST API key (prefix "xkeysib-"), from Brevo's
# Settings -> SMTP & API -> "API Keys" tab. Not the "SMTP" tab's SMTP key
# (prefix "xsmtpsib-") — that's a different credential for a different
# protocol and this app's REST calls will get a 401 "Key not found" if you
# paste that one in here instead.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# RESEND_API_KEY=
# Must be verified in Brevo (Senders, Domains & Dedicated IPs -> Senders)
# before Brevo will accept sends from it — an unverified address fails even
# with a valid API key. Leaving this blank keeps email in safe mock/log mode.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CourtBazaar

# Comma-separated addresses to alert when something needs admin attention
# (currently: a new review submitted for moderation). Blank = logs only.
ADMIN_ALERT_EMAILS=

# --- CAPTCHA (optional, disabled by default) ---
# Protects the anonymous lead-draft and review-submit endpoints. Leave
# CAPTCHA_PROVIDER unset/"none" to keep them open (current production
# default). Set to turnstile|hcaptcha|recaptcha + CAPTCHA_SECRET_KEY to
# require a solved challenge token — see backend/captcha.py.
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=

# --- SMS/OTP: Fast2SMS or MSG91 (India-focused, cheaper than Twilio) ---
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=CRTBZR

# --- WhatsApp (optional, unrelated to the SMS_PROVIDER switch above) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# STRIPE_API_KEY=   # currently non-functional — see audit report

# --- AI / OCR features (optional; /ai/* and /doc-intel/analyze routes) ---
# These currently depend on a private Emergent-platform package and will
# 500 until re-implemented against a real provider (OpenAI/Gemini) — see
# audit report "Remaining production risks."
# EMERGENT_LLM_KEY=
